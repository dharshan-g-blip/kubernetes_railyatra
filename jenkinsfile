pipeline {
    agent any

    environment {
    IMAGE_NAME = 'railyatra-app'
    KUBECONFIG = 'C:\\SPB_Data\\.kube\\config'
    JAVA_HOME  = 'C:\\Program Files\\Eclipse Adoptium\\jdk-21.0.12.8-hotspot'
    PATH       = "D:\\Program Files\\apache-maven-3.9.16-bin\\apache-maven-3.9.16\\bin;${JAVA_HOME}\\bin;${env.PATH}"
    }

    stages {
        stage('Build and Test with Maven') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t %IMAGE_NAME%:%BUILD_NUMBER% -t %IMAGE_NAME%:latest .'
            }
        }

        stage('Check Kubernetes') {
            steps {
                bat 'kubectl config use-context docker-desktop'
                bat 'kubectl get nodes'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f k8s/deployment.yaml'
                // A unique tag per build forces a rolling update every time.
                bat 'kubectl set image deployment/railyatra railyatra=%IMAGE_NAME%:%BUILD_NUMBER%'
            }
        }

        stage('Verify Deployment') {
            steps {
                bat 'kubectl rollout status deployment/railyatra --timeout=120s'
                bat 'kubectl get deployments'
                bat 'kubectl get pods'
                bat 'kubectl get services'
            }
        }
    }

    post {
        success {
            echo 'RailYatra deployed. Open http://localhost:30008'
        }
        failure {
            echo 'Pipeline failed. Check the Console Output for the first error.'
        }
    }
}

